{
  "name": "markbujehein-github-io",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro sync && tsc --noEmit --runExternalCode",
    "build": "pnpm run check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "check:output": "python -I tools/check_output.py dist https://markbujehein.github.io",
    "lint": "oxlint src",
    "format": "oxfmt src astro.config.mjs vitest.config.ts tsconfig.json package.json .oxfmtrc.json && prettier --write \"src/**/*.{astro,svelte}\"",
    "format:check": "oxfmt --check src astro.config.mjs vitest.config.ts tsconfig.json package.json .oxfmtrc.json && prettier --check \"src/**/*.{astro,svelte}\""
  },
  "dependencies": {
    "@astrojs/svelte": "^9.1.6",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "^0.2.0",
    "@types/node": "^24.19.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "7.1.0-beta",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
