{
  "name": "markbujehein-github-io",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro sync && tsc --noEmit --runExternalCode",
    "build": "node -e \"require('fs').rmSync('public/pagefind',{recursive:true,force:true})\" && pnpm run check && astro build && pagefind --site dist",
    "index:dev": "astro build --outDir .pagefind-build && pagefind --site .pagefind-build --output-path public/pagefind",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "e2e": "pnpm run build && playwright test",
    "notebooks": "bash notebooks/export.sh",
    "check:output": "python -I tools/check_output.py dist https://markbujehein.github.io",
    "lint": "oxlint src e2e",
    "format": "oxfmt src e2e astro.config.mjs playwright.config.ts vitest.config.ts tsconfig.json package.json .oxfmtrc.json && prettier --write \"src/**/*.astro\"",
    "format:check": "oxfmt --check src e2e astro.config.mjs playwright.config.ts vitest.config.ts tsconfig.json package.json .oxfmtrc.json && prettier --check \"src/**/*.astro\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/preact": "^6.1.6",
    "@astrojs/sitemap": "^3.7.5",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "katex": "^0.19.1",
    "preact": "^11.2.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "^0.2.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "7.1.0-beta",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.18.0"
}
