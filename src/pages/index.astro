---
import { Image } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import CVNested from "../components/CVNested.astro";
import Hero from "../components/Hero.astro";
import NewsList from "../components/NewsList.astro";
import ProjectList from "../components/ProjectList.astro";
import { site } from "../config/site";
import profile from "../assets/profile.jpg";
import Base from "../layouts/Base.astro";
import { sortByOrder } from "../utils/cv";
import { latest } from "../utils/news";
import { sortByImportance } from "../utils/projects";

const home = await getEntry("home", "index");
if (!home) throw new Error('Missing home entry "src/content/home/index.md"');
const { Content: Bio } = await render(home);

const featured = sortByImportance(await getCollection("projects")).slice(0, 3);
const skills = sortByOrder(await getCollection("cv")).find((s) => s.data.type === "nested_list");
const news = latest(await getCollection("news"), 5); // the full list lives at /news/
---

<Base title={site.title} description={site.description}>
  <Hero
    slot="hero"
    name={site.author}
    headline={home.data.hero.headline}
    detail={home.data.hero.detail}
    role={home.data.subtitle}
    start={home.data.hero.start}
    contact={home.data.hero.contact}
    linkedin={home.data.hero.linkedin}
    cvHref="/cv/"
    projectsHref="/projects/"
  />

  <div class="mt-12 page-stack">
    <section>
      <h2 class="heading-bar mb-4 section-heading">who I am</h2>
      <Image
        class="float-right mb-4 ml-6 size-40 rounded-full object-cover"
        src={profile}
        alt="Portrait of Mark B.H. Sørensen"
        width={160}
        height={160}
        densities={[1, 2]}
      />
      <div class="prose-site">
        <Bio />
      </div>
    </section>

    <section>
      <h2 class="heading-bar mb-4 section-heading">what I have done</h2>
      <ProjectList projects={featured} />
    </section>

    {
      skills && skills.data.type === "nested_list" && (
        <section>
          <h2 class="heading-bar mb-4 section-heading">what I can do</h2>
          <CVNested section={skills.data} />
        </section>
      )
    }

    <section>
      <h2 class="heading-bar mb-4 section-heading">
        <a
          href="/news/"
          class="text-inherit no-underline hover:text-accent-700 dark:hover:text-accent-300"
        >
          news
        </a>
      </h2>
      <NewsList items={news} />
    </section>
  </div>
</Base>
