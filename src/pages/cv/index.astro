---
import { getCollection } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CVSection from "../../components/cv/CVSection.astro";
import PageJumpNav from "../../components/PageJumpNav.astro";
import Base from "../../layouts/Base.astro";
import { sortByOrder } from "../../utils/cv";

const sections = sortByOrder(await getCollection("cv"));
---

<Base title="cv" description="Research and professional experience, education and skills.">
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "CV" }]} />
  <header class="page-header mb-8">
    <h1 class="page-title">cv</h1>
    <p class="page-description">Research and professional experience, education and skills.</p>
    <a href="/pdf/cv.pdf" class="btn"> Download CV (PDF) </a>
  </header>
  <div class="grid grid-cols-1 gap-8 md:grid-cols-[14rem_minmax(0,1fr)]">
    <PageJumpNav items={sections.map((s) => ({ id: s.id, label: s.data.title }))} />
    <div class="space-y-12">
      {sections.map((section) => <CVSection id={section.id} section={section.data} />)}
    </div>
  </div>
</Base>
