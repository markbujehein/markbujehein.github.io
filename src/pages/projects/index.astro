---
import { getCollection } from "astro:content";
import ProjectFilter from "../../components/ProjectFilter";
import ProjectList from "../../components/ProjectList.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Base from "../../layouts/Base.astro";
import { groupByCategory, sortByImportance } from "../../utils/projects";

const categories = ["research", "software"] as const;
const projects = sortByImportance(await getCollection("projects"));
groupByCategory(projects, categories); // throws on a category outside the list
const filterItems = projects.map((p) => ({ id: p.id, data: { category: p.data.category } }));
---

<Base
  title="projects"
  description="Research and software projects from my studies and current work."
>
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Projects" }]} />
  <header class="page-header mb-8">
    <h1 class="page-title">projects</h1>
    <p class="page-description">Research and software projects from my studies and current work.</p>
  </header>
  <div class="mb-6">
    <ProjectFilter
      client:load
      items={filterItems}
      categories={categories.map((c) => ({ id: c, label: c }))}
    />
  </div>
  <ProjectList projects={projects} headingLevel="h2" />
</Base>
