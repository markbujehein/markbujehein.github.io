---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  // cacheKey lets incremental builds skip a project page until its content changes.
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
    cacheKey: String(project.digest),
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Base title={project.data.title} description={project.data.summary}>
  <article class="page">
    <p>
      <a href="/projects/">← projects</a>
    </p>
    <h1>{project.data.title}</h1>
    <p class="summary">{project.data.summary}</p>
    <Content />
  </article>
</Base>

<style>
  .page {
    max-width: 44rem;
    margin: 0 auto;
  }
  .summary {
    font-size: 1.15rem;
  }
</style>
