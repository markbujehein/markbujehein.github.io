---
import CVNested from "../CVNested.astro";
import type { CVSection } from "../../utils/cv";

interface Props {
  id: string;
  section: CVSection;
}

const { id, section } = Astro.props;
---

<section {id} class="scroll-mt-32 md:scroll-mt-24">
  <h2 class="heading-bar mb-5 section-heading">{section.title}</h2>
  {
    section.type === "map" && (
      <dl class="grid gap-x-6 gap-y-2 surface-card sm:grid-cols-[max-content_1fr]">
        {section.contents.map((item) => (
          <>
            <dt class="entry-meta font-bold text-lampblack-ink dark:text-lunar-vellum">
              {item.name}
            </dt>
            <dd class="entry-summary">{item.value}</dd>
          </>
        ))}
      </dl>
    )
  }
  {section.type === "nested_list" && <CVNested section={section} />}
  {
    section.type === "time_table" && (
      <ul class="timeline">
        {section.contents.map((entry) => (
          <li class="timeline-item">
            <p class="entry-index">{entry.year}</p>
            <h3 class="entry-title">{entry.title}</h3>
            {entry.institution && <p class="entry-supporting">{entry.institution}</p>}
            {entry.description.length > 0 && (
              <ul class="mt-1 list-disc space-y-1 pl-5 entry-summary marker:text-spice-melange">
                {entry.description.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    )
  }
  {
    section.type === "list" && (
      <ul class="list-disc space-y-1 surface-card pl-9 entry-summary marker:text-spice-melange">
        {section.contents.map((line) => (
          <li>{line}</li>
        ))}
      </ul>
    )
  }
</section>
