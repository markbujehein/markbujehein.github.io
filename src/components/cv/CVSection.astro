---
import CVNested from "../CVNested.astro";
import type { CVSection } from "../../utils/cv";

interface Props {
  id: string;
  section: CVSection;
}

const { id, section } = Astro.props;
---

<section {id}>
  <h2>{section.title}</h2>
  {section.type === "map" && (
    <dl>
      {section.contents.map((item) => (
        <>
          <dt>{item.name}</dt>
          <dd>{item.value}</dd>
        </>
      ))}
    </dl>
  )}
  {section.type === "nested_list" && <CVNested section={section} />}
  {section.type === "time_table" && (
    <ul class="entries">
      {section.contents.map((entry) => (
        <li>
          <div class="when">{entry.year}</div>
          <div>
            <h3>{entry.title}</h3>
            {entry.institution && <p class="where">{entry.institution}</p>}
            {entry.description.length > 0 && (
              <ul>
                {entry.description.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ul>
  )}
  {section.type === "list" && (
    <ul>
      {section.contents.map((line) => (
        <li>{line}</li>
      ))}
    </ul>
  )}
</section>

<style>
  section {
    margin: 2.5rem 0;
  }
  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1.5rem;
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 0;
  }
  .entries {
    padding: 0;
    list-style: none;
  }
  .entries > li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid #d9d4e5;
  }
  .when {
    font-size: 0.9rem;
  }
  h3 {
    margin: 0;
    font-size: 1.05rem;
  }
  .where {
    margin: 0.1rem 0 0.4rem;
    opacity: 0.8;
  }
  @media (max-width: 767px) {
    .entries > li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
