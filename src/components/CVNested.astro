---
import type { CVSection } from "../utils/cv";

interface Props {
  section: Extract<CVSection, { type: "nested_list" }>;
}

const { section } = Astro.props;
---

<div class="groups">
  {
    section.contents.map((group) => (
      <div>
        <h3>{group.title}</h3>
        <ul>
          {group.elements.map((element) => (
            <li>{element}</li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.5rem;
  }
  h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
  }
  ul {
    margin: 0;
    padding-left: 1.1rem;
  }
</style>
