---
import type { CVSection } from "../utils/cv";
import Terms from "./Terms.astro";

interface Props {
  section: Extract<CVSection, { type: "nested_list" }>;
}

const { section } = Astro.props;
---

<div class="@container">
  <div class="grid gap-4 @xl:grid-cols-2 @4xl:grid-cols-3">
    {
      section.contents.map((group) => (
        <div class="surface-card">
          <h3 class="mb-2 entry-title">{group.title}</h3>
          <ul class="list-disc space-y-1 pl-5 entry-summary marker:text-accent-500">
            {group.elements.map((element) => (
              <li>
                <Terms text={element} />
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</div>
