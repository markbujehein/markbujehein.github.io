---
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: CollectionEntry<"projects">[];
  /** Heading level of each card title: h3 under a section heading, h2 directly under the page h1. */
  headingLevel?: "h2" | "h3";
}

const { projects, headingLevel: Heading = "h3" } = Astro.props;
---

<div class="@container">
  <ul class="grid gap-4 @xl:grid-cols-2 @4xl:grid-cols-3">
    {projects.map((project) => (
      <li
        class="surface-card-hover interactive relative flex flex-col gap-2"
        data-project={project.id}
        data-category={project.data.category}
      >
        <span class="meta-chip self-start capitalize">{project.data.category}</span>
        <Heading class="entry-title">
          <a
            href={`/projects/${project.id}/`}
            class="text-inherit no-underline after:absolute after:inset-0 after:content-['']"
          >
            {project.data.title}
          </a>
        </Heading>
        <p class="entry-supporting">{project.data.summary}</p>
      </li>
    ))}
  </ul>
</div>
