---
interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6 text-sm">
  <ol class="flex flex-wrap items-center gap-x-2 text-silverpoint dark:text-marginalia">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {item.href && i < items.length - 1 ? (
            <a href={item.href} class="hover:text-arcane-intellect dark:hover:text-arcane-torrent">
              {item.label}
            </a>
          ) : (
            <span
              aria-current="page"
              class="font-semibold text-lampblack-ink dark:text-lunar-vellum"
            >
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
