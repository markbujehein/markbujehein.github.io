---
interface Props {
  items: { id: string; label: string }[];
}

const { items } = Astro.props;
---

<nav
  aria-label="On this page"
  class="jump-nav sticky top-[3.75rem] z-30 -mx-4 border-b border-paper-300 bg-paper-50/95 px-4 backdrop-blur md:top-20 md:mx-0 md:self-start md:border-0 md:bg-transparent md:px-0 md:backdrop-blur-none dark:border-ink-700 dark:bg-ink-950/95 dark:md:bg-transparent"
  data-jump-nav
>
  <ul class="flex gap-1 overflow-x-auto py-1 md:flex-col md:overflow-visible">
    {items.map((item) => (
      <li>
        <a
          href={`#${item.id}`}
          class="block rounded px-2 py-2 text-sm whitespace-nowrap md:whitespace-normal text-ink-600 no-underline hover:text-accent-700 aria-[current=location]:bg-accent-100 aria-[current=location]:font-bold aria-[current=location]:text-accent-800 dark:text-paper-400 dark:hover:text-accent-300 dark:aria-[current=location]:bg-ink-800 dark:aria-[current=location]:text-accent-300"
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // Scroll-spy: mark the link of the section nearest the top with aria-current="location".
  let observer: IntersectionObserver | undefined;
  document.addEventListener("astro:page-load", () => {
    observer?.disconnect(); // one observer per visit, not one per navigation
    const nav = document.querySelector<HTMLElement>("[data-jump-nav]");
    if (!nav) return;
    const links = [...nav.querySelectorAll<HTMLAnchorElement>("a")];
    const targets = links
      .map((a) => document.getElementById(a.hash.slice(1)))
      .filter((el): el is HTMLElement => el !== null);
    const next = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const a of links) {
            if (a.hash === `#${entry.target.id}`) a.setAttribute("aria-current", "location");
            else a.removeAttribute("aria-current");
          }
        }
      },
      { rootMargin: "-80px 0px -70% 0px" },
    );
    targets.forEach((t) => next.observe(t));
    observer = next;
  });
</script>
