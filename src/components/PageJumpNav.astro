---
interface Props {
  items: { id: string; label: string }[];
}

const { items } = Astro.props;
---

<nav
  aria-label="On this page"
  class="jump-nav sticky top-[3.75rem] z-30 -mx-4 border-b border-sunlit-vellum-darker bg-sunlit-vellum/95 px-4 backdrop-blur md:top-20 md:mx-0 md:self-start md:border-0 md:bg-transparent md:px-0 md:backdrop-blur-none dark:border-midnight-codex-lighter dark:bg-iron-gall/95 dark:md:bg-transparent"
  data-jump-nav
>
  <ul class="flex gap-1 overflow-x-auto py-1 md:flex-col md:overflow-visible">
    {
      items.map((item) => (
        <li>
          <a
            href={`#${item.id}`}
            class="block rounded px-2 py-2 text-sm whitespace-nowrap text-silverpoint no-underline hover:text-arcane-intellect aria-[current=location]:bg-spice-melange/15 aria-[current=location]:font-bold aria-[current=location]:text-spice-melange md:whitespace-normal dark:text-marginalia dark:hover:text-arcane-torrent dark:aria-[current=location]:bg-midnight-codex-lighter dark:aria-[current=location]:text-gravity-gun"
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  // Scroll-spy: mark the link of the section nearest the top with aria-current="location".
  let observer: IntersectionObserver | undefined;
  document.addEventListener("astro:page-load", () => {
    observer?.disconnect(); // one observer per visit, not one per navigation
    const nav = document.querySelector<HTMLElement>("[data-jump-nav]");
    if (!nav) return;
    const links = [...nav.querySelectorAll<HTMLAnchorElement>("a")];
    const targets = links
      .map((a) => document.getElementById(a.hash.slice(1)))
      .filter((el): el is HTMLElement => el !== null);
    const next = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const a of links) {
            if (a.hash === `#${entry.target.id}`) a.setAttribute("aria-current", "location");
            else a.removeAttribute("aria-current");
          }
        }
      },
      { rootMargin: "-80px 0px -70% 0px" },
    );
    targets.forEach((t) => next.observe(t));
    observer = next;
  });
</script>
