---
import { site } from "../config/site";
import { navState } from "../utils/nav";
import ThemeToggle from "./ThemeToggle";

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-paper-300/90 bg-paper-50/85 backdrop-blur dark:border-ink-700 dark:bg-ink-950/85">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-2 sm:px-6">
    <a href="/" class="font-heading text-lg font-bold text-ink-950 no-underline dark:text-paper-50">
      {site.title}
    </a>
    <div class="flex items-center gap-2">
      <nav aria-label="Main">
        <ul class="flex items-center gap-1">
          {site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={navState(path, item.href)}
                class="inline-flex min-h-11 items-center rounded-md px-3 text-sm font-semibold text-ink-600 no-underline hover:text-accent-700 aria-[current]:text-ink-950 nav-dot dark:text-paper-300 dark:hover:text-accent-300 dark:aria-[current]:text-paper-50"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle client:load transition:persist />
    </div>
  </div>
</header>
