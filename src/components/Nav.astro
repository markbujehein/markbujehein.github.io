---
import { site } from "../config/site";
import { navState } from "../utils/nav";

const path = Astro.url.pathname;
---

<nav aria-label="Main">
  <ul>
    {site.nav.map((item) => (
      <li>
        <a href={item.href} aria-current={navState(path, item.href)}>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  nav ul {
    display: flex;
    gap: 1.25rem;
    justify-content: flex-end;
    max-width: 64rem;
    margin: 0 auto 1rem;
    padding: 0;
    list-style: none;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a[aria-current] {
    font-weight: 700;
    text-decoration: underline;
  }
</style>
