---
import { site } from "../config/site";
import { navState } from "../utils/nav";
import Search from "./Search.astro";
import ThemeToggle from "./ThemeToggle";

const path = Astro.url.pathname;
const link =
  "inline-flex min-h-11 items-center rounded px-3 text-sm font-semibold text-silverpoint no-underline hover:text-arcane-intellect aria-[current]:text-lampblack-ink dark:text-lunar-vellum-darker dark:hover:text-arcane-torrent dark:aria-[current]:text-lunar-vellum";
---

<header
  class="sticky top-0 z-40 border-b border-sunlit-vellum-darker bg-sunlit-vellum/90 backdrop-blur dark:border-midnight-codex-lighter dark:bg-iron-gall/90"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-2 sm:px-6">
    <a
      href="/"
      class="font-heading text-lg font-bold text-lampblack-ink no-underline dark:text-lunar-vellum"
    >
      {site.title}
    </a>
    <div class="flex items-center gap-2">
      <nav aria-label="Main" class="hidden sm:block">
        <ul class="flex items-center gap-1">
          {
            site.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={navState(path, item.href)}
                  class={`${link} nav-dot`}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <Search />
      <ThemeToggle client:load transition:persist />
      <!-- Phones: the same links in a menu that needs no JavaScript. -->
      <details class="relative sm:hidden">
        <summary
          aria-label="Menu"
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded border border-sunlit-vellum-darker text-silverpoint dark:border-midnight-codex-lighter dark:text-lunar-vellum-darker [&::-webkit-details-marker]:hidden"
        >
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <nav
          aria-label="Main (menu)"
          class="absolute right-0 mt-2 w-52 rounded-md border border-l-2 border-sunlit-vellum-darker border-l-spice-melange bg-sunlit-vellum p-2 dark:border-midnight-codex-lighter dark:border-l-gravity-gun dark:bg-midnight-codex"
        >
          <ul>
            {
              site.nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={navState(path, item.href)}
                    class={`${link} w-full aria-[current=page]:font-bold`}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
