---
import { render, type CollectionEntry } from "astro:content";
import { formatNewsDate, isoDate } from "../utils/date";

interface Props {
  items: CollectionEntry<"news">[];
}

const items = [...Astro.props.items].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const rendered = await Promise.all(
  items.map(async (item) => ({ item, Content: (await render(item)).Content })),
);
---

<ul class="news">
  {
    rendered.map(({ item, Content }) => (
      <li>
        <time datetime={isoDate(item.data.date, item.data.monthOnly)}>
          {formatNewsDate(item.data.date, item.data.monthOnly)}
        </time>
        <div>
          <Content />
        </div>
      </li>
    ))
  }
</ul>

<style>
  .news {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    padding: 0.5rem 0;
    border-top: 1px solid #d9d4e5;
  }
  time {
    font-weight: 500;
  }
  div :global(p) {
    margin: 0;
  }
</style>
